{
  "name": "costear-backend",
  "version": "0.1.0",
  "description": "CosteAR — API de automatización de costos para profesionales argentinos",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/infrastructure/http/server.ts",
    "briefing": "node .claude/hooks/briefing.mjs",
    "build": "prisma generate && tsc",
    "start": "node dist/infrastructure/http/entry.js",
    "start:worker": "node dist/infrastructure/workers/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:http": "vitest run tests/http",
    "check:tests-base": "node scripts/check-tests-con-base.mjs",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node scripts/migrate-dev.mjs",
    "prisma:deploy": "node scripts/migrate-deploy.mjs",
    "db:rls": "node scripts/apply-rls.mjs",
    "db:seed": "node --env-file=.env prisma/seed.mjs",
    "seed:tenant-avicola": "tsx --env-file=.env prisma/seed-tenant-avicola.ts",
    "admin:reset": "tsx --env-file=.env scripts/seed-admin.ts",
    "db:backfill-trazabilidad": "node scripts/backfill-trazabilidad.mjs",
    "db:setup": "node scripts/migrate-deploy.mjs && node scripts/apply-rls.mjs",
    "worker": "tsx --env-file=.env src/infrastructure/workers/index.ts",
    "vault:index": "tsx --env-file=.env src/application/vault-indexer/cli.ts",
    "keys:generate": "node scripts/generate-keys.mjs",
    "prepare": "husky || node -e \"process.exit(0)\""
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.2.2",
    "@prisma/client": "^6.2.1",
    "@sentry/node": "^10.68.0",
    "@sentry/profiling-node": "^10.68.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.10",
    "cloudinary": "^2.10.0",
    "decimal.js": "^10.4.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.1",
    "otplib": "^12.0.1",
    "pino": "^9.6.0",
    "prisma": "^6.2.1",
    "qrcode": "^1.5.4",
    "resend": "^4.0.1",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "overrides": {
    "@types/node": "$@types/node"
  },
  "lint-staged": {
    "*.{ts,js}": "eslint --fix"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "argon2@0.41.1": true,
    "esbuild@0.28.0": true,
    "esbuild@0.21.5": true,
    "msgpackr-extract@3.0.4": true,
    "prisma@6.19.3": true
  }
}
